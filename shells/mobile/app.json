{
  "expo": {
    "name": "RSC Shell",
    "slug": "rsc-mfe-shell",
    "scheme": "rscshell",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "sh.sph.rscmfe",
      "appleTeamId": "3EWL9B9GPV",
      "supportsTablet": false,
      "associatedDomains": [
        "webcredentials:rscmfe.sph.sh",
        "applinks:rscmfe.sph.sh"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "sh.sph.rscmfe",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "rscmfe.sph.sh"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "RSC Shell uses Face ID to unlock the app."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "RSC Shell uses the camera to find products from a photo.",
          "photosPermission": "RSC Shell opens a photo you pick to find products in it.",
          "microphonePermission": false
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/android-icon-foreground.png",
          "imageWidth": 200,
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/android-icon-foreground.png",
            "backgroundColor": "#030712"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c5038600-e288-440c-849f-e137a64bcc7b"
      }
    },
    "owner": "ayhansipahi"
  }
}
